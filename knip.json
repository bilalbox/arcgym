{
  "$schema": "https://unpkg.com/knip@5/overview/configuration/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@swc/core", "vitest"],
      "ignoreBinaries": ["uv", "wrangler"]
    },
    "apps/arcgym-web": {
      "entry": ["functions/**/!(*.test).ts"],
      "project": ["src/**/*.{ts,tsx}", "functions/**/*.ts"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    },
    "packages/drill-core": {
      "project": ["src/**/*.ts"]
    },
    "packages/diagrams": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
