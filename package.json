{
  "name": "arcgym-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ArcGym: Daily judgment practice for Salesforce Architects (Cloudflare Pages + React)",
  "scripts": {
    "dev": "pnpm --filter @arcgym/web dev",
    "typecheck": "tsc --noEmit && pnpm --recursive run typecheck",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "check:arch": "depcruise --config .dependency-cruiser.cjs apps packages scripts",
    "check:dead": "knip",
    "check:clones": "jscpd",
    "verify": "pnpm typecheck && pnpm check && pnpm test && pnpm check:arch && pnpm check:dead && pnpm check:clones",
    "lint": "biome check",
    "format": "biome format --write",
    "build": "pnpm diagrams:export && npx tsx scripts/build-drills.ts && pnpm typecheck && pnpm check && pnpm --recursive run build",
    "build:drills": "npx tsx scripts/build-drills.ts",
    "diagrams:export": "pnpm --filter @arcgym/diagrams export",
    "test:diagram-qa": "pnpm --filter @arcgym/diagrams test:diagram-qa",
    "drill:status": "npx tsx scripts/set-drill-status.ts",
    "seed": "npx tsx scripts/seed-drills.ts",
    "seed:force": "npx tsx scripts/seed-drills.ts --force",
    "seed:clear": "npx tsx scripts/seed-drills.ts --clear",
    "feedback:report": "npx tsx scripts/feedback-report.ts",
    "feedback:pull": "npx tsx scripts/feedback-report.ts --pull",
    "test": "pnpm --recursive run test",
    "preview": "pnpm --filter @arcgym/web preview",
    "prototype:troubleshoot": "pnpm --filter @arcgym/web exec wrangler dev --config ../../packages/drill-core/prototypes/troubleshooting-ai/wrangler.toml",
    "prototype:cause-bakeout": "pnpm --filter @arcgym/web exec wrangler dev --config ../../packages/drill-core/prototypes/cause-grade-bakeout/wrangler.toml",
    "deploy": "pnpm typecheck && pnpm check && pnpm build && pnpm test:diagram-qa && pnpm seed && pnpm --filter @arcgym/web run deploy:pages",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
