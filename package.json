{
  "name": "arcgym",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ArcGym: Daily judgment practice for Salesforce Architects (Cloudflare Pages + React)",
  "scripts": {
    "dev": "pnpm build:drills && vite --config apps/arcgym-web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "check:arch": "depcruise --config .dependency-cruiser.cjs apps packages scripts",
    "check:dead": "knip",
    "check:clones": "jscpd",
    "verify": "pnpm typecheck && pnpm check && pnpm test && pnpm check:arch && pnpm check:dead && pnpm check:clones",
    "lint": "biome check",
    "format": "biome format --write",
    "build": "pnpm diagrams:export && pnpm build:drills && pnpm typecheck && pnpm check && vite build --config apps/arcgym-web/vite.config.ts",
    "build:drills": "tsx scripts/build-drills.ts",
    "diagrams:export": "tsx packages/diagrams/scripts/export-svgs.tsx",
    "test:diagram-qa": "pnpm diagrams:export && playwright test --config packages/diagrams/playwright.config.ts",
    "drill:status": "tsx scripts/set-drill-status.ts",
    "seed": "tsx scripts/seed-drills.ts",
    "seed:force": "tsx scripts/seed-drills.ts --force",
    "seed:clear": "tsx scripts/seed-drills.ts --clear",
    "feedback:report": "tsx scripts/feedback-report.ts",
    "feedback:pull": "tsx scripts/feedback-report.ts --pull",
    "feedback:migrate": "tsx scripts/migrate-feedback-to-d1.ts",
    "db:migrate": "CI=true wrangler d1 migrations apply arcgym-d1 --local --config apps/arcgym-web/wrangler.toml",
    "db:migrate:local": "CI=true wrangler d1 migrations apply arcgym-d1 --local --config apps/arcgym-web/wrangler.toml",
    "db:migrate:remote": "CI=true wrangler d1 migrations apply arcgym-d1 --remote --config apps/arcgym-web/wrangler.toml",
    "test": "vitest run && pnpm test:diagram-qa",
    "test:unit": "vitest run",
    "preview": "vite preview --config apps/arcgym-web/vite.config.ts",
    "prototype:troubleshoot": "wrangler dev --config packages/drill-core/prototypes/troubleshooting-ai/wrangler.toml",
    "prototype:cause-bakeout": "wrangler dev --config packages/drill-core/prototypes/cause-grade-bakeout/wrangler.toml",
    "deploy:pages": "wrangler pages deploy apps/arcgym-web/dist --project-name=arcgym",
    "deploy": "pnpm typecheck && pnpm check && pnpm build && pnpm test:diagram-qa && pnpm seed && pnpm deploy:pages",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.64.1",
    "@swc/core": "^1.16.18",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.6.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449"
}
