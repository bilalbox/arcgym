{
	"name": "arcgym",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "ArcGym: Daily judgment practice for Salesforce Architects (Cloudflare Pages + React)",
	"scripts": {
		"dev": "pnpm build:drills && vite --config apps/arcgym-web/vite.config.ts",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"lint:graph": "tsx scripts/run-rev-dep.ts",
		"lint:complexity": "tsx scripts/ratchets/run-complexity.ts",
		"lint:py": "uvx ruff@0.17.2 check scripts/crawler && uvx ruff@0.17.2 format --check scripts/crawler && uvx basedpyright@1.40.2 && uvx tach@0.35.3 check && uvx vulture@2.16 scripts/crawler vulture_whitelist.py",
		"gate:fast": "pnpm lint && pnpm lint:graph && pnpm lint:complexity && pnpm typecheck && pnpm lint:py",
		"gate:fast:py": "pnpm gate:fast",
		"gate": "pnpm gate:fast && pnpm test",
		"test:ratchets": "bash tests/ratchets/ratchet-contract.test.sh",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"build:functions": "wrangler pages functions build apps/arcgym-web/functions --compatibility-flags=\"nodejs_compat\" --outdir .wrangler/functions-build",
		"build:drills": "tsx scripts/build-drills.ts",
		"build": "pnpm build:drills && pnpm typecheck && pnpm lint && pnpm build:functions && vite build --config apps/arcgym-web/vite.config.ts",
		"drill:status": "tsx scripts/set-drill-status.ts",
		"seed": "tsx scripts/seed-drills.ts",
		"seed:force": "tsx scripts/seed-drills.ts --force",
		"seed:clear": "tsx scripts/seed-drills.ts --clear",
		"feedback:report": "tsx scripts/feedback-report.ts",
		"feedback:pull": "tsx scripts/feedback-report.ts --pull",
		"feedback:migrate": "tsx scripts/migrate-feedback-to-d1.ts",
		"db:migrate": "CI=true wrangler d1 migrations apply arcgym-d1 --local --config apps/arcgym-web/wrangler.toml",
		"db:migrate:local": "CI=true wrangler d1 migrations apply arcgym-d1 --local --config apps/arcgym-web/wrangler.toml",
		"db:migrate:remote": "CI=true wrangler d1 migrations apply arcgym-d1 --remote --config apps/arcgym-web/wrangler.toml",
		"test": "vitest run",
		"test:unit": "vitest run",
		"preview": "vite preview --config apps/arcgym-web/vite.config.ts",
		"prototype:troubleshoot": "wrangler dev --config packages/drill-core/prototypes/troubleshooting-ai/wrangler.toml",
		"prototype:cause-bakeout": "wrangler dev --config packages/drill-core/prototypes/cause-grade-bakeout/wrangler.toml",
		"deploy:pages": "wrangler pages deploy dist --project-name=arcgym --cwd apps/arcgym-web",
		"deploy": "pnpm typecheck && pnpm lint && pnpm build && pnpm seed && pnpm deploy:pages",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource/geist-sans": "^5.3.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-slot": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.60.0",
		"pele": "^1.8.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@swc/core": "^1.16.18",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"rev-dep": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.3"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449",
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		],
		"*.py": [
			"uvx ruff@0.17.2 check --fix",
			"uvx ruff@0.17.2 format"
		]
	}
}
