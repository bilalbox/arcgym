<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ArcGym Utility Bar</masterLabel>
    <description>Daily 2-minute architectural judgment practice docked in your Salesforce Utility Bar</description>
    <targets>
        <target>lightning__UtilityBar</target>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__UtilityBar">
            <property name="width" type="Integer" default="480" />
            <property name="height" type="Integer" default="640" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
