# Local-only Cloudflare Pages Functions secrets (gitignored as .dev.vars).
# Generate fresh random values — never reuse the old committed placeholder.
# Example: openssl rand -hex 32

ARCGYM_HMAC_SECRET=replace_with_openssl_rand_hex_32_hmac
ARCGYM_ADMIN_KEY=replace_with_openssl_rand_hex_32_admin
ARCGYM_VOTE_HMAC_SECRET=replace_with_openssl_rand_hex_32_vote
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
SESSION_SECRET=replace_with_openssl_rand_hex_32_session
LEARNER_PEPPER=replace_with_openssl_rand_hex_32_pepper

